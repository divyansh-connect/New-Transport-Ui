datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  driver
  workshop
  oil
  visitor
  admin
  coworker
}

enum UserStatus {
  Pending
  Approved
  Rejected
}

enum PaymentStatus {
  Paid
  Unpaid
  Trial
}

model User {
  id                   String        @id @default(uuid()) @map("id")
  customId             String        @unique @map("custom_id")
  name                 String        @db.VarChar(100) @map("name")
  lastName             String?       @db.VarChar(100) @map("last_name")
  mobileNo             String        @unique @db.VarChar(20) @map("mobile_no")
  password             String        @db.VarChar(255) @map("password")
  carPlateNumber       String?       @db.VarChar(30) @map("car_plate_number")
  email                String?       @unique @db.VarChar(150) @map("email")
  role                 Role          @default(visitor) @map("role")
  status               UserStatus    @default(Pending) @map("status")
  registrationDate     DateTime      @default(now()) @map("registration_date")
  subscriptionDuration String        @db.VarChar(50) @map("subscription_duration")
  amountPaid           String        @db.VarChar(20) @map("amount_paid")
  paymentStatus        PaymentStatus @default(Unpaid) @map("payment_status")
  paymentMethod        String        @default("None") @db.VarChar(50) @map("payment_method")

  // GPS Coordinates (latitude and longitude)
  latitude        Decimal? @db.Decimal(10, 8) @map("latitude")
  longitude       Decimal? @db.Decimal(11, 8) @map("longitude")
  trackLocation   Boolean  @default(true) @map("track_location")
  rejectionReason String?  @db.Text @map("rejection_reason")

  // Document URLs and verification statuses
  licenseName   String? @db.VarChar(255) @map("license_name")
  licenseStatus String  @default("Pending Verification") @db.VarChar(50) @map("license_status")
  licenseUrl    String? @db.Text @map("license_url")

  insuranceName   String? @db.VarChar(255) @map("insurance_name")
  insuranceStatus String  @default("Pending Verification") @db.VarChar(50) @map("insurance_status")
  insuranceUrl    String? @db.Text @map("insurance_url")

  backgroundCheckName   String? @db.VarChar(255) @map("background_check_name")
  backgroundCheckStatus String  @default("Pending Verification") @db.VarChar(50) @map("background_check_status")
  backgroundCheckUrl    String? @db.Text @map("background_check_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  payments      Payment[]
  notifications Notification[]
  permissions   Permission[]

  @@index([role])
  @@index([status])
  @@index([mobileNo])
  @@map("users")
}

model Permission {
  id         String   @id @default(uuid()) @map("id")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleName String   @db.VarChar(100) @map("module_name")
  canView    Boolean  @default(false) @map("can_view")
  canAdd     Boolean  @default(false) @map("can_add")
  canEdit    Boolean  @default(false) @map("can_edit")
  canDelete  Boolean  @default(false) @map("can_delete")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, moduleName], name: "userId_moduleName")
  @@index([userId])
  @@map("permissions")
}

model Payment {
  id       String   @id @default(uuid()) @map("id")
  customId String   @unique @map("custom_id")
  driverId String   @map("driver_id")
  user     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  name     String   @db.VarChar(150) @map("name")
  amount   String   @db.VarChar(20) @map("amount")
  gateway  String   @db.VarChar(50) @map("gateway")
  status   String   @db.VarChar(30) @map("status")
  date     DateTime @default(now()) @map("date")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([driverId])
  @@index([customId])
  @@map("payments")
}

model Notification {
  id       String  @id @default(uuid()) @map("id")
  customId String  @unique @map("custom_id")
  type     String  @db.VarChar(50) @map("type")
  title    String  @db.VarChar(255) @map("title")
  message  String  @db.Text @map("message")
  read     Boolean @default(false) @map("read")

  // Optional linkage to user
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model Ticket {
  id       String   @id @default(uuid()) @map("id")
  customId String   @unique @map("custom_id")
  subject  String   @db.VarChar(255) @map("subject")
  details  String   @db.Text @map("details")
  user     String   @db.VarChar(150) @map("user")
  mobileNo String   @db.VarChar(50) @map("mobile_no")
  status   String   @default("Open") @db.VarChar(30) @map("status")
  date     DateTime @default(now()) @map("date")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([customId])
  @@map("tickets")
}

// Singleton platform-level settings controlled by admin
model PlatformSettings {
  id                    Int     @id @default(autoincrement())
  // Payment control — which roles must pay
  payDriverPayment      Boolean @default(true)  @map("pay_driver")
  payWorkshopPayment    Boolean @default(false) @map("pay_workshop")
  payVisitorPayment     Boolean @default(false) @map("pay_visitor")
  payOilChangePayment   Boolean @default(false) @map("pay_oilchange")
  // Visitor visibility control
  showVisitorServices   Boolean @default(true)  @map("show_visitor_services")
  // Free trial settings
  freeTrialEnabled      Boolean @default(false) @map("free_trial_enabled")
  freeTrialDuration     String  @default("1 Month") @db.VarChar(50) @map("free_trial_duration")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model Notice {
  id          String   @id @default(uuid()) @map("id")
  customId    String   @unique @map("custom_id")
  title       String   @db.VarChar(255) @map("title")
  type        String   @default("Freight") @db.VarChar(50) @map("type")
  priority    String   @default("Normal") @db.VarChar(50) @map("priority")
  location    String   @default("All Zones") @db.VarChar(255) @map("location")
  description String   @db.Text @map("description")
  date        String   @db.VarChar(100) @map("date")
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("notices")
}


